NODE_ENV=production
PORT=3000
PIPER_MODEL=/app/models/en_US-lessac-medium.onnx
MAX_CONCURRENCY=15
LOGGING_MODE=PLAIN_TEXT
LOGGING_LEVEL=info
SERVICE_NAME=piper-tts-rest-api

SYNTHESIZE_MAX_BODY_SIZE_BYTES=2000000
SYNTHESIZE_MAX_ATTEMPTS=3
SYNTHESIZE_RETRY_DELAY_MS=30000
SYNTHESIZE_STATUS_CALLBACK_TIMEOUT_MS=10000
SYNTHESIZE_GEN_UPLOAD_URL_TIMEOUT_MS=10000
SYNTHESIZE_UPLOAD_IDLE_TIMEOUT_MS=10000
SYNTHESIZE_UPLOAD_TIMEOUT_MS=600000
SYNTHESIZE_WORDS_PER_MINUTE=150
RABBITMQ_URL=amqp://rabbitmq:5672
SYNTHESIZE_EXCHANGE=synthesize
SYNTHESIZE_WORK_QUEUE=synthesize.work
SYNTHESIZE_RETRY_QUEUE=synthesize.retry
SYNTHESIZE_DEAD_LETTER_EXCHANGE=synthesize.dlx
SYNTHESIZE_DEAD_LETTER_QUEUE=synthesize.dlq
SYNTHESIZE_REQUIRE_HTTPS_CALLBACKS=true
# Comma-separated hostnames. Leave empty to permit any host after URL validation.
SYNTHESIZE_CALLBACK_ALLOWED_HOSTS=

OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_BATCH_MAX_PENDING_SPANS=2048
OTEL_BATCH_SPANS_PER_EXPORT=512
OTEL_BATCH_FLUSH_INTERVAL_MS=5000
OTEL_BATCH_EXPORT_TIMEOUT_MS=30000
