{
  "branches": ["main", "master"],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits",
        "releaseRules": [
          { "breaking": true, "release": "major" },
          {
            "type": "docs",
            "release": false
          },
          {
            "type": "chore",
            "release": false
          },
          {
            "type": "style",
            "release": false
          },
          {
            "type": "refactor",
            "release": false
          },
          {
            "type": "test",
            "release": false
          },
          {
            "type": "build",
            "release": false
          },
          {
            "type": "ci",
            "release": false
          }
        ]
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      { "preset": "conventionalcommits" }
    ],
    [
      "@semantic-release/exec",
      {
        "publishCmd": "docker build -f Dockerfile --build-arg SERVICE_VERSION=${nextRelease.version} -t $DOCKERHUB_REPOSITORY:${nextRelease.version} -t $DOCKERHUB_REPOSITORY:latest . && docker push $DOCKERHUB_REPOSITORY:${nextRelease.version} && docker push $DOCKERHUB_REPOSITORY:latest"
      }
    ],
    "@semantic-release/github"
  ]
}
