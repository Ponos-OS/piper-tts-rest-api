{
  "components": {
    "schemas": {
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "description": "Where the error occurred, e.g. 'body.items[3].tags' or 'path.thing-id'",
            "type": "string"
          },
          "message": {
            "description": "Error message text",
            "type": "string"
          },
          "value": {
            "description": "The value at the given location"
          }
        },
        "type": "object"
      },
      "ErrorModel": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "description": "A human-readable explanation specific to this occurrence of the problem.",
            "examples": [
              "Property foo is required but is missing."
            ],
            "type": "string"
          },
          "errors": {
            "description": "Optional list of individual error details",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "instance": {
            "description": "A URI reference that identifies the specific occurrence of the problem.",
            "examples": [
              "https://example.com/error-log/abc123"
            ],
            "format": "uri",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "examples": [
              400
            ],
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "A short, human-readable summary of the problem type. This value should not change between occurrences of the error.",
            "examples": [
              "Bad Request"
            ],
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "description": "A URI reference to human-readable documentation for the error.",
            "examples": [
              "https://example.com/errors/example"
            ],
            "format": "uri",
            "type": "string"
          }
        },
        "type": "object"
      },
      "Request": {
        "additionalProperties": false,
        "properties": {
          "genUploadUrl": {
            "description": "Called once per attempt to get a presigned PUT URL. Replies with 200 and {\"uploadUrl\": \"...\"}.",
            "examples": [
              "https://your-server.example/generate-upload-url"
            ],
            "pattern": "\\S",
            "type": "string"
          },
          "statusCallbackUrl": {
            "description": "Receives the progress and status reports.",
            "examples": [
              "https://your-server.example/synthesis-status"
            ],
            "pattern": "\\S",
            "type": "string"
          },
          "text": {
            "description": "The text to synthesize.",
            "examples": [
              "Hello world, this is a test of the asynchronous synthesis API."
            ],
            "pattern": "\\S",
            "type": "string"
          }
        },
        "required": [
          "text",
          "genUploadUrl",
          "statusCallbackUrl"
        ],
        "type": "object"
      },
      "SynthesizeOutputBody": {
        "additionalProperties": false,
        "properties": {
          "jobId": {
            "description": "Identifies the job in the callbacks.",
            "examples": [
              "e52cbe80-17de-4204-a983-bb1c10c36341"
            ],
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "jobId"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Text to speech with Piper. /v1/speak streams an MP3; /v1/synthesize queues a job that uploads it.",
    "title": "Piper TTS REST API",
    "version": "unknown"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "text/plain": {
                "schema": {
                  "examples": [
                    "OK"
                  ],
                  "type": "string"
                }
              }
            },
            "description": "The service is up.",
            "headers": {
              "Content-Type": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Health check",
        "tags": [
          "Health"
        ]
      }
    },
    "/v1/speak": {
      "post": {
        "description": "Streams the MP3 in the response, chunked, without a Content-Length. Aborting the request frees its concurrency slot.",
        "operationId": "speak",
        "parameters": [
          {
            "in": "header",
            "name": "Content-Type",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "text": {
                    "description": "The text to speak.",
                    "examples": [
                      "Hello from Piper API"
                    ],
                    "pattern": "\\S",
                    "type": "string"
                  }
                },
                "required": [
                  "text"
                ],
                "type": "object"
              }
            },
            "text/plain": {
              "schema": {
                "examples": [
                  "Hello from plain text"
                ],
                "type": "string"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "audio/mpeg": {
                "schema": {
                  "contentMediaType": "application/octet-stream",
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "The MP3 audio stream.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                }
              },
              "Content-Disposition": {
                "schema": {
                  "type": "string"
                }
              },
              "x-trace-id": {
                "description": "The trace id, when OTEL_ENABLED=true.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Bad Request"
          },
          "413": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Request Entity Too Large"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Synchronous text to speech",
        "tags": [
          "Speech"
        ]
      }
    },
    "/v1/synthesize": {
      "post": {
        "description": "Queues a job that generates the MP3 and uploads it to the presigned URL returned by genUploadUrl. Progress goes to statusCallbackUrl. A 202 means queued, not done.",
        "operationId": "synthesize",
        "parameters": [
          {
            "description": "Passed through to the callbacks. Optional.",
            "in": "header",
            "name": "Authorization",
            "schema": {
              "description": "Passed through to the callbacks. Optional.",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Request"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SynthesizeOutputBody"
                }
              }
            },
            "description": "Accepted"
          },
          "413": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Request Entity Too Large"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Asynchronous text to speech",
        "tags": [
          "Speech"
        ]
      }
    }
  }
}
